# Server-only. Contact email sent in the AIC-User-Agent header, as requested by the
# Art Institute of Chicago API. Optional for local development; set a real, public
# contact address in production. Do not commit real values.
AIC_CONTACT_EMAIL=

# Server-only. Public origin of the deployed site (e.g. https://gallery-atlas.<account>.workers.dev).
# Used for absolute URLs in Open Graph, hreflang, sitemap.xml and robots.txt.
SITE_URL=
